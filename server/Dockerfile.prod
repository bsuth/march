# TODO: create a real prod docker file

FROM ghcr.io/gleam-lang/gleam:v1.19.2-erlang-alpine AS build

# This Dockerfile should be run using the parent directory as the build context.
# See: https://docs.docker.com/build/concepts/context/
COPY . /march/
RUN cd /march/server && gleam export erlang-shipment

FROM erlang:29-alpine

COPY --from=build /march/server/build/erlang-shipment /march/server

WORKDIR /march/server

CMD ["/march/server/entrypoint.sh", "run"]
