pub fn new_name(exclude: List(String)) {
  // We attempt to make a unique name up to 10 times, and otherwise give up.
  int.range(0, 10, Error(Nil), fn(name, _) {
    use _ <- yuzu.error_(name)

    let name =
      [list.sample(adjectives, 1), list.sample(animals, 1)]
      |> list.flatten()
      |> string.join(" ")

    case list.contains(exclude, name) {
      False -> Ok(name)
      True -> Error(Nil)
    }
  })
}
